{
  "format": "dsh-theme",
  "version": 1,
  "id": "minimal",
  "name": "Minimal",
  "description": "Pure white and black, nothing extra.",
  "colorScheme": "light",
  "tokens": {
    "--dsw-alias-bg-base": "#ffffff",
    "--dsw-alias-bg-layer-1": "#ffffff",
    "--dsw-alias-bg-layer-2": "#fafafa",
    "--dsw-alias-bg-layer-3": "#f4f4f5",
    "--dsw-alias-bg-overlay": "#ececee",
    "--dsw-alias-bg-module-platform": "#fafafa",
    "--dsw-alias-bg-mask-1": "rgba(0, 0, 0, 0.24)",
    "--dsw-alias-bg-mask-2": "rgba(0, 0, 0, 0.12)",
    "--dsw-alias-border-l1": "rgba(0, 0, 0, 0.05)",
    "--dsw-alias-border-l2": "rgba(0, 0, 0, 0.1)",
    "--dsw-alias-border-l3": "rgba(0, 0, 0, 0.14)",
    "--dsw-alias-brand-primary": "#111111",
    "--dsw-alias-brand-text": "#111111",
    "--dsw-alias-button-primary-fill": "#111111",
    "--dsw-alias-button-primary-hover": "#000000",
    "--dsw-alias-button-elevated-fill": "#ffffff",
    "--dsw-alias-button-floating-fill": "#fafafa",
    "--dsw-alias-button-floating-hover": "#f4f4f5",
    "--dsw-alias-button-info-fill": "#111111",
    "--dsw-alias-button-info-hover": "#000000",
    "--dsw-alias-button-primary-dimmed": "#f4f4f5",
    "--dsw-alias-interactive-bg-hover": "rgba(0, 0, 0, 0.04)",
    "--dsw-alias-interactive-bg-active": "rgba(0, 0, 0, 0.08)",
    "--dsw-alias-label-primary": "#111111",
    "--dsw-alias-label-secondary": "#55555c",
    "--dsw-alias-label-tertiary": "#88888f",
    "--dsw-alias-label-caption": "#88888f",
    "--dsw-alias-label-primary-foreground": "#ffffff",
    "--dsw-alias-markdown-code-block": "#f7f7f7",
    "--dsw-alias-markdown-inline-code": "#f0f0f1",
    "--dsw-alias-scrollbar-bg-l2": "#ddddde",
    "--dsw-alias-scrollbar-hover-l2": "#c8c8cb",
    "--dsw-alias-state-error-primary": "#dc2626",
    "--dsw-alias-state-success-primary": "#16a34a",
    "--dsw-alias-state-warn-primary": "#d97706",
    "--dsw-alias-toast-bg": "#111111",
    "--dsw-alias-tooltip-bg": "#111111",
    "--dsw-specific-bubble": "#f2f2f2",
    "--dsw-specific-bubble-highlight": "#e8e8e9",
    "--dsw-specific-input-major": "#ffffff",
    "--dsw-specific-menu": "#f4f4f5",
    "--dsw-specific-sidebar-fill": "#f7f7f7",
    "--dsw-specific-sidebar-nav-item-active": "#eeeeef",
    "--dsw-specific-sidebar-nav-item-hover": "#f2f2f3",
    "--dsw-specific-sidebar-nav-item-active-accent": "rgba(0, 0, 0, 0.06)"
  }
}
