{
  "format": "dsh-theme",
  "version": 1,
  "id": "catppuccin",
  "name": "Catppuccin Mocha",
  "description": "Low-saturation mauve, soft on the eyes.",
  "colorScheme": "dark",
  "tokens": {
    "--dsw-alias-bg-base": "#1e1e2e",
    "--dsw-alias-bg-layer-1": "#181825",
    "--dsw-alias-bg-layer-2": "#242438",
    "--dsw-alias-bg-layer-3": "#313244",
    "--dsw-alias-bg-overlay": "#3a3a52",
    "--dsw-alias-bg-module-platform": "#181825",
    "--dsw-alias-bg-mask-1": "rgba(0, 0, 0, 0.24)",
    "--dsw-alias-bg-mask-2": "rgba(0, 0, 0, 0.12)",
    "--dsw-alias-border-l1": "rgba(205, 214, 244, 0.08)",
    "--dsw-alias-border-l2": "rgba(205, 214, 244, 0.15)",
    "--dsw-alias-border-l3": "rgba(205, 214, 244, 0.22)",
    "--dsw-alias-brand-primary": "#cba6f7",
    "--dsw-alias-brand-text": "#cba6f7",
    "--dsw-alias-button-primary-fill": "#cba6f7",
    "--dsw-alias-button-primary-hover": "#d4b4f8",
    "--dsw-alias-button-elevated-fill": "#181825",
    "--dsw-alias-button-floating-fill": "#242438",
    "--dsw-alias-button-floating-hover": "#313244",
    "--dsw-alias-button-info-fill": "#cba6f7",
    "--dsw-alias-button-info-hover": "#d4b4f8",
    "--dsw-alias-button-primary-dimmed": "#313244",
    "--dsw-alias-interactive-bg-hover": "rgba(205, 214, 244, 0.06)",
    "--dsw-alias-interactive-bg-active": "rgba(205, 214, 244, 0.11)",
    "--dsw-alias-label-primary": "#cdd6f4",
    "--dsw-alias-label-secondary": "#a6adc8",
    "--dsw-alias-label-tertiary": "#6c7086",
    "--dsw-alias-label-caption": "#6c7086",
    "--dsw-alias-label-primary-foreground": "#1e1e2e",
    "--dsw-alias-markdown-code-block": "#181825",
    "--dsw-alias-markdown-inline-code": "#2a2c42",
    "--dsw-alias-scrollbar-bg-l2": "#45476a",
    "--dsw-alias-scrollbar-hover-l2": "#565a85",
    "--dsw-alias-state-error-primary": "#f38ba8",
    "--dsw-alias-state-success-primary": "#a6e3a1",
    "--dsw-alias-state-warn-primary": "#f9e2af",
    "--dsw-alias-toast-bg": "#313244",
    "--dsw-alias-tooltip-bg": "#313244",
    "--dsw-specific-bubble": "#313244",
    "--dsw-specific-bubble-highlight": "#3a3d58",
    "--dsw-specific-input-major": "#181825",
    "--dsw-specific-menu": "#313244",
    "--dsw-specific-sidebar-fill": "#14141f",
    "--dsw-specific-sidebar-nav-item-active": "#313244",
    "--dsw-specific-sidebar-nav-item-hover": "#26263a",
    "--dsw-specific-sidebar-nav-item-active-accent": "rgba(203, 166, 247, 0.16)"
