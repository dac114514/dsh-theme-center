{
  "format": "dsh-theme",
  "version": 1,
  "id": "one-light",
  "name": "One Light",
  "description": "VS Code's official light theme — crisp blue on near-white.",
  "colorScheme": "light",
  "tokens": {
    "--dsw-alias-bg-base": "#fafafa",
    "--dsw-alias-bg-layer-1": "#f3f3f3",
    "--dsw-alias-bg-layer-2": "#ececec",
    "--dsw-alias-bg-layer-3": "#e6e6e6",
    "--dsw-alias-bg-overlay": "#dcdcdc",
    "--dsw-alias-bg-module-platform": "#f3f3f3",
    "--dsw-alias-bg-mask-1": "rgba(0, 0, 0, 0.24)",
    "--dsw-alias-bg-mask-2": "rgba(0, 0, 0, 0.12)",
    "--dsw-alias-border-l1": "rgba(56, 58, 66, 0.08)",
    "--dsw-alias-border-l2": "rgba(56, 58, 66, 0.14)",
    "--dsw-alias-border-l3": "rgba(56, 58, 66, 0.2)",
    "--dsw-alias-brand-primary": "#4078f2",
    "--dsw-alias-brand-text": "#4078f2",
    "--dsw-alias-button-primary-fill": "#4078f2",
    "--dsw-alias-button-primary-hover": "#3966d6",
    "--dsw-alias-button-elevated-fill": "#f3f3f3",
    "--dsw-alias-button-floating-fill": "#ececec",
    "--dsw-alias-button-floating-hover": "#e6e6e6",
    "--dsw-alias-button-info-fill": "#4078f2",
    "--dsw-alias-button-info-hover": "#3966d6",
    "--dsw-alias-button-primary-dimmed": "#e6e6e6",
    "--dsw-alias-interactive-bg-hover": "rgba(56, 58, 66, 0.05)",
    "--dsw-alias-interactive-bg-active": "rgba(56, 58, 66, 0.09)",
    "--dsw-alias-label-primary": "#383a42",
    "--dsw-alias-label-secondary": "#696e77",
    "--dsw-alias-label-tertiary": "#a0a1a7",
    "--dsw-alias-label-caption": "#a0a1a7",
    "--dsw-alias-label-primary-foreground": "#ffffff",
    "--dsw-alias-markdown-code-block": "#f3f3f3",
    "--dsw-alias-markdown-inline-code": "#eceef2",
    "--dsw-alias-scrollbar-bg-l2": "#d5d5da",
    "--dsw-alias-scrollbar-hover-l2": "#c2c2c8",
    "--dsw-alias-state-error-primary": "#d73a49",
    "--dsw-alias-state-success-primary": "#1a7f37",
    "--dsw-alias-state-warn-primary": "#9a6700",
    "--dsw-alias-toast-bg": "#383a42",
    "--dsw-alias-tooltip-bg": "#383a42",
    "--dsw-specific-bubble": "#e9edf4",
    "--dsw-specific-bubble-highlight": "#dde4ee",
    "--dsw-specific-input-major": "#ffffff",
    "--dsw-specific-menu": "#e6e6e6",
    "--dsw-specific-sidebar-fill": "#f3f3f3",
    "--dsw-specific-sidebar-nav-item-active": "#e6e6e6",
    "--dsw-specific-sidebar-nav-item-hover": "#ececec",
    "--dsw-specific-sidebar-nav-item-active-accent": "rgba(64, 120, 242, 0.12)"
  }
}
